# Optional: Connect to Supabase for persistent multi-user live claps & views
# If left empty, the portfolio seamlessly runs in local simulation mode with localStorage & BroadcastChannel sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contact Form Email Delivery
# Web3Forms: Obtain your free access key at https://web3forms.com by submitting your email (shahaarav2806@gmail.com).
# If left empty, the form automatically falls back to FormSubmit directly forwarding submissions to shahaarav2806@gmail.com!
VITE_WEB3FORMS_ACCESS_KEY=

# AI Assistant Backend URL (FastAPI)
# In local development: http://localhost:8000
# In production on Vercel: https://<your-render-app>.onrender.com
VITE_BACKEND_URL=http://localhost:8000
