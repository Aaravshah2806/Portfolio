# ==========================================
# Root .gitignore for Aarav Shah Portfolio
# ==========================================

# Environment & Secrets (Never commit API keys)
.env
.env.local
.env.*.local
.env.production
*.pem
*.key

# Node / Frontend dependencies & build outputs
node_modules/
Frontend/node_modules/
dist/
dist-ssr/
build/
Frontend/dist/
Frontend/dist-ssr/
Frontend/build/

# Vite & Agent temp directories
.vite/
Frontend/.vite/
.impeccable/
Frontend/.impeccable/
preview/
Frontend/preview/

# Python & Backend temp directories
__pycache__/
Backend/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
Backend/.venv/
Backend/venv/
Backend/env/
.pytest_cache/
Backend/.pytest_cache/
coverage/
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor directories
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

implementation_plan.md
